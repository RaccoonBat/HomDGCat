{
  "name": "star-rail-reference",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "data:update": "python -B data-update/game_data.py update",
    "data:validate": "python -B data-update/game_data.py validate --collection site/data",
    "data:dialogues": "node data-update/generate-dialogue-worlds.mjs",
    "predev": "node data-update/generate-dialogue-worlds.mjs --if-needed",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write src build data-update/generate-dialogue-worlds.mjs vite.config.ts eslint.config.ts index.html package.json tsconfig*.json .prettierrc.json",
    "format:check": "prettier --check src build data-update/generate-dialogue-worlds.mjs vite.config.ts eslint.config.ts index.html package.json tsconfig*.json .prettierrc.json",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prebuild": "node data-update/generate-dialogue-worlds.mjs --if-needed",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "antd": "^6.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
}
